{
  "name": "nexatalent-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "NexaTalent Frontend Ecosystem — Website, Auth & Protected Multi-Role Portals",
  "workspaces": [
    "shared",
    "website",
    "auth",
    "portals/*"
  ],
  "scripts": {
    "dev:website": "npm run dev -w website",
    "dev:auth": "npm run dev -w auth",
    "dev:superadmin": "npm run dev -w portals/superadmin",
    "dev:employee": "npm run dev -w portals/employee",
    "dev:recruiter": "npm run dev -w portals/recruiter",
    "dev:employer": "npm run dev -w portals/employer",
    "dev:candidate": "npm run dev -w portals/candidate",
    "build": "npm run build --workspaces --if-present",
    "build:website": "npm run build -w website",
    "build:auth": "npm run build -w auth",
    "build:portals": "npm run build --workspace=portals/superadmin --workspace=portals/employee --workspace=portals/recruiter --workspace=portals/employer --workspace=portals/candidate",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^5.5.4"
  }
}
