{
  "name": "nexatalent-platform",
  "version": "1.0.0",
  "private": true,
  "description": "NexaTalent — Production-grade recruitment and talent solutions platform",
  "workspaces": [
    "frontend/shared",
    "frontend/website",
    "frontend/auth",
    "frontend/portals/*",
    "backend"
  ],
  "scripts": {
    "dev:website": "npm run dev -w frontend/website",
    "dev:auth": "npm run dev -w frontend/auth",
    "dev:superadmin": "npm run dev -w frontend/portals/superadmin",
    "dev:employee": "npm run dev -w frontend/portals/employee",
    "dev:recruiter": "npm run dev -w frontend/portals/recruiter",
    "dev:employer": "npm run dev -w frontend/portals/employer",
    "dev:candidate": "npm run dev -w frontend/portals/candidate",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces --if-present",
    "build:website": "npm run build -w frontend/website",
    "build:auth": "npm run build -w frontend/auth",
    "build:superadmin": "npm run build -w frontend/portals/superadmin",
    "build:employee": "npm run build -w frontend/portals/employee",
    "build:recruiter": "npm run build -w frontend/portals/recruiter",
    "build:employer": "npm run build -w frontend/portals/employer",
    "build:candidate": "npm run build -w frontend/portals/candidate",
    "build:backend": "npm run build -w backend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
