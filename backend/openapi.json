{
  "openapi": "3.0.3",
  "info": {
    "title": "NexaTalent Enterprise Recruitment API",
    "version": "2.0.0",
    "description": "All 5 spec phases. Real JWT (15m access / 7d refresh rotation), bcrypt, 20 roles, 17 permissions, file-persisted DB, zod validation, idempotent finance, interview-gated chat. Legacy paths kept for old frontend builds."
  },
  "servers": [{ "url": "http://localhost:5000" }],
  "security": [{ "bearerAuth": [] }],
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } } },
  "paths": {
    "/api/health": { "get": { "summary": "Health + phase list", "responses": { "200": { "description": "healthy" } } } },
    "/api/v1/auth/login": { "post": { "summary": "Phase 0/1: bcrypt login, role-locked 403", "responses": { "200": { "description": "JWT pair" }, "401": { "description": "bad credentials" }, "403": { "description": "suspended or wrong workspace" } } } },
    "/api/v1/auth/refresh": { "post": { "summary": "Rotate JWT pair, reuse detection", "responses": { "200": { "description": "new pair" }, "401": { "description": "reused/invalid" } } } },
    "/api/v1/auth/logout": { "post": { "summary": "Revoke + audit", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/auth/me": { "get": { "summary": "Resolve session", "responses": { "200": { "description": "session" } } } },
    "/api/v1/auth/forgot-password": { "post": { "summary": "Anti-enumeration request", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/auth/reset-confirm": { "post": { "summary": "Set new 8-char password", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/auth/bootstrap": { "post": { "summary": "One-time platform-owner bootstrap (empty directory + BOOTSTRAP_KEY)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/auth/register/{type}": { "post": { "summary": "Register candidate|employer|recruiter|vendor", "responses": { "201": { "description": "created" } } } },
    "/api/v1/tenants": { "get": { "summary": "List orgs", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Provision org", "responses": { "201": { "description": "created" } } } },
    "/api/v1/tenants/{id}/verify": { "patch": { "summary": "Approve/reject verification (separate from account status)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/tenants/{id}/suspend": { "patch": { "summary": "Suspend/reactivate with reason (perm: suspend)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/users": { "get": { "summary": "Directory (paged, no hashes)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create user (perm: assign)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/users/{id}/status": { "patch": { "summary": "Suspend/reactivate + revoke sessions + reassign", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/branches": { "get": { "summary": "Branches (tenant-scoped)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create branch", "responses": { "201": { "description": "created" } } } },
    "/api/v1/directory/candidates": { "get": { "summary": "Admin candidate directory (masked w/o perm)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/requisitions": { "get": { "summary": "Phase 1: list (paged, tenant-scoped)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create requisition (zod)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/requisitions/{id}/status": { "patch": { "summary": "State-machine transition", "responses": { "200": { "description": "ok" }, "422": { "description": "illegal transition" } } } },
    "/api/v1/jobs": { "get": { "summary": "List jobs (paged)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create job (entitlement: jobs.create)", "responses": { "201": { "description": "created" }, "402": { "description": "no subscription" } } } },
    "/api/v1/jobs-public": { "get": { "summary": "Eligible public jobs only", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/jobs/{id}/status": { "patch": { "summary": "Job state machine", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/candidates/search": { "get": { "summary": "Tiered search preview|full|contact (quota-guarded)", "responses": { "200": { "description": "ok" }, "429": { "description": "quota exhausted" } } } },
    "/api/v1/applications": { "get": { "summary": "ATS list, role-scoped + paged", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Apply (unique job+candidate, expiry-checked)", "responses": { "201": { "description": "applied" }, "409": { "description": "duplicate" } } } },
    "/api/v1/applications/{id}/history": { "get": { "summary": "Stage timeline", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/applications/{id}/stage": { "patch": { "summary": "Move ATS stage + history + event", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/interviews": { "get": { "summary": "List (role-scoped)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Schedule (auto-enables chat)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/interviews/{id}/feedback": { "post": { "summary": "Panel feedback (rating 1-5, never mutates status)", "responses": { "201": { "description": "created" } } }, "get": { "summary": "List feedback for interview", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/credit-notes": { "get": { "summary": "List credit notes", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/allocations": { "get": { "summary": "Payment allocations ledger", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/subscription-changes": { "get": { "summary": "Subscription history", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/usage-ledger": { "get": { "summary": "Raw quota ledger (finance)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/conversations": { "get": { "summary": "List chats (app-scoped)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/conversations/{id}/messages": { "get": { "summary": "Thread (locked until interview scheduled)", "responses": { "200": { "description": "ok" }, "403": { "description": "CHAT_LOCKED" } } } },
    "/api/v1/jobs/{id}": { "get": { "summary": "Job detail + acceptingApplications flag", "responses": { "200": { "description": "ok" }, "404": { "description": "not found" } } } },
    "/api/v1/applications/{id}/withdraw": { "post": { "summary": "Candidate withdraws (closes chat, history kept)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/interviews/{id}": { "patch": { "summary": "Reschedule/cancel with reason (history preserved)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/conversations/{id}/close": { "patch": { "summary": "Close chat, history preserved", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/talent-pools/{id}": { "patch": { "summary": "Edit/archive pool", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/talent-pools/{id}/members": { "get": { "summary": "List pool members", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/talent-pools/{id}/members/{memberId}": { "delete": { "summary": "Remove member", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/refunds": { "get": { "summary": "List refunds", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Process refund (idempotent, perm: refund)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/users/{id}": { "put": { "summary": "Edit directory record (audited, role allow-listed)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/skills": { "get": { "summary": "Skill taxonomy (?q=)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Add skill (ops)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/documents": { "get": { "summary": "List documents (scoped)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Upload base64 doc (5MB, allow-listed types, versioned)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/documents/{id}/download": { "get": { "summary": "Download with ownership check", "responses": { "200": { "description": "file" } } } },
    "/api/v1/consents": { "get": { "summary": "My consent record", "responses": { "200": { "description": "ok" } } }, "put": { "summary": "Update marketing/visibility consent", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/consents/withdraw": { "post": { "summary": "Withdraw consent (privates profile)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/consents/export": { "get": { "summary": "Export my data (JSON)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/opportunities": { "get": { "summary": "List opportunities (paged)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create from lead", "responses": { "201": { "description": "created" } } } },
    "/api/v1/opportunities/{id}/stage": { "patch": { "summary": "Move opportunity stage", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/proposals": { "get": { "summary": "List proposals (?leadId=, paged)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create proposal (Draft)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/proposals/{id}/status": { "patch": { "summary": "Draft→Sent→Accepted/Rejected", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/meetings": { "get": { "summary": "List meetings (?leadId=, sorted, paged)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Log meeting (+activity row)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/meetings/{id}": { "patch": { "summary": "Update outcome/notes", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/timesheets": { "get": { "summary": "List timesheets (scoped, paged)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Vendor submits timesheet", "responses": { "201": { "description": "created" } } } },
    "/api/v1/timesheets/{id}/approve": { "patch": { "summary": "Approve/reject with note (once)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/commissions/{id}/adjustments": { "get": { "summary": "List adjustments", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Add adjustment (perm, idempotent, recomputes totals)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/agency-profiles": { "get": { "summary": "Agency directory (real records)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Onboard agency", "responses": { "201": { "description": "created" } } } },
    "/api/v1/agency-profiles/{id}": { "patch": { "summary": "Verify/suspend/edit agency", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/notifications/{id}/read": { "patch": { "summary": "Mark notification read", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/messages": { "post": { "summary": "Send (rate-limited 30/5min)", "responses": { "201": { "description": "sent" } } } },
    "/api/v1/talent-pools": { "get": { "summary": "List pools", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create pool (entitlement)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/talent-pools/{id}/members": { "post": { "summary": "Add candidate", "responses": { "201": { "description": "created" } } } },
    "/api/v1/saved-jobs": { "get": { "summary": "My saved jobs", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Save (unique)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/saved-jobs/{jobId}": { "delete": { "summary": "Unsave", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/offers": { "post": { "summary": "Issue offer", "responses": { "201": { "description": "created" } } } },
    "/api/v1/placements": { "get": { "summary": "List placements", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Mark joined (triggers commission eval)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/plans": { "get": { "summary": "Plans", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create plan version", "responses": { "201": { "description": "created" } } } },
    "/api/v1/subscriptions": { "get": { "summary": "List subscriptions", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Subscribe (snapshots plan)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/subscriptions/{id}/status": { "patch": { "summary": "8-state lifecycle", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/usage": { "get": { "summary": "Quota summary", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/outreach": { "get": { "summary": "Campaigns", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Send campaign (idempotent quota)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/invoices": { "get": { "summary": "Invoices", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Issue (immutable, tax math)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/credit-notes": { "post": { "summary": "Amend via credit note (perm: refund)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/payments": { "get": { "summary": "Payments", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Record payment (idempotent)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/payments/webhook": { "post": { "summary": "Provider webhook (signature-verified)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/commission-agreements": { "get": { "summary": "Agreements", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create (configurable trigger)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/commissions": { "get": { "summary": "Commission ledger", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/commissions/{id}/approve": { "patch": { "summary": "Approve (perm: approve)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/payouts": { "get": { "summary": "Payouts (separate ledger)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Process payout", "responses": { "201": { "description": "created" } } } },
    "/api/v1/reconciliation": { "get": { "summary": "Invoiced vs paid", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/leads": { "get": { "summary": "Leads (paged)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create lead", "responses": { "201": { "description": "created" } } } },
    "/api/v1/leads/{id}/stage": { "patch": { "summary": "Pipeline transition (lost needs reason)", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/leads/{id}/activities": { "post": { "summary": "Log activity", "responses": { "201": { "description": "created" } } } },
    "/api/v1/leads/{id}/convert": { "post": { "summary": "Convert to org (dedupe, preserves history)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/targets": { "get": { "summary": "Sales targets", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Set target", "responses": { "201": { "description": "created" } } } },
    "/api/v1/performance": { "get": { "summary": "Sales KPIs", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/submissions": { "get": { "summary": "Agency submissions", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Submit (90-day duplicate window → Duplicate-Review)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/submissions/{id}/status": { "patch": { "summary": "Review submission", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/notifications": { "get": { "summary": "Inbox + delivery log", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/notifications/prefs": { "get": { "summary": "My prefs", "responses": { "200": { "description": "ok" } } }, "put": { "summary": "Save prefs", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/reports/{name}": { "get": { "summary": "candidate-pipeline|requisition-ageing|receivables|commission-liabilities|sales-pipeline|recruiter-workload", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/settings": { "get": { "summary": "Platform settings", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Save settings", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/tasks": { "get": { "summary": "Tasks", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/tasks/{id}": { "patch": { "summary": "Update task", "responses": { "200": { "description": "ok" } } } }
  }
}
