    "/api/health": { "get": { "summary": "Health + phase list", "responses": { "200": { "description": "healthy" } } } },
    "/api/v1/auth/login": { "post": { "summary": "Phase 0/1: bcrypt login, role-locked 403", "responses": { "200": { "description": "JWT pair" }, "401": { "description": "bad credentials" }, "403": { "description": "suspended or wrong workspace" } } } },

    "/api/v1/auth/mfa/setup": { "post": { "summary": "Start TOTP enrol (returns secret + otpauth URL)", "responses": { "200": { "description": "ok" }, "409": { "description": "already enabled" } } } },

    "/api/v1/auth/mfa/verify": { "post": { "summary": "Confirm TOTP code, enable MFA, one-time backup codes", "responses": { "200": { "description": "ok" }, "401": { "description": "bad code" } } } },

    "/api/v1/auth/mfa/challenge": { "post": { "summary": "Complete MFA login with ticket + otp|backupCode", "responses": { "200": { "description": "tokens" }, "401": { "description": "bad/expired" } } } },

    "/api/v1/auth/mfa/disable": { "post": { "summary": "Disable MFA (password-confirmed)", "responses": { "200": { "description": "ok" } } } },

    "/api/v1/auth/mfa/status": { "get": { "summary": "MFA enabled flag for own account", "responses": { "200": { "description": "ok" } } } },

    "/api/v1/auth/mfa/reset": { "post": { "summary": "Admin MFA reset (perm: manage_permissions, audited)", "responses": { "200": { "description": "ok" } } } },    "/api/v1/auth/refresh": { "post": { "summary": "Rotate JWT pair, reuse detection", "responses": { "200": { "description": "new pair" }, "401": { "description": "reused/invalid" } } } },
    "/api/v1/auth/logout": { "post": { "summary": "Revoke + audit", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/auth/me": { "get": { "summary": "Resolve session", "responses": { "200": { "description": "session" } } } },
    "/api/v1/auth/forgot-password": { "post": { "summary": "Anti-enumeration request", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/auth/reset-confirm": { "post": { "summary": "Set new 8-char password", "responses": { "200": { "description": "ok" } } } },
    "/api/v1/auth/bootstrap": { "post": { "summary": "One-time platform-owner bootstrap (empty directory + BOOTSTRAP_KEY)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/auth/register/{type}": { "post": { "summary": "Register candidate|employer|recruiter|vendor", "responses": { "201": { "description": "created" } } } },
    "/api/v1/tenants": { "get": { "summary": "List orgs", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Provision org", "responses": { "201": { "description": "created" } } } },
