    "/api/v1/users": { "get": { "summary": "Directory (paged, no hashes)", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Create user (perm: assign)", "responses": { "201": { "description": "created" } } } },
    "/api/v1/users/{id}/status": { "patch": { "summary": "Suspend/reactivate + revoke sessions + reassign", "responses": { "200": { "description": "ok" } } } },

