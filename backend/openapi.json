    "/api/v1/candidates/search": { "get": { "summary": "Tiered search preview|full|contact (quota-guarded)", "responses": { "200": { "description": "ok" }, "429": { "description": "quota exhausted" } } } },
    "/api/v1/applications": { "get": { "summary": "ATS list, role-scoped + paged, jobId + requisitionId filters", "responses": { "200": { "description": "ok" } } }, "post": { "summary": "Apply (unique job+candidate, expiry-checked)", "responses": { "201": { "description": "applied" }, "409": { "description": "duplicate" } } } },
