{
  "openapi": "3.0.3",
  "info": {
    "title": "NexaTalent Enterprise Recruitment API",
    "version": "2.0.0",
    "description": "All 5 spec phases. Real JWT (15m access / 7d refresh rotation), bcrypt, 20 roles, 17 permissions, file-persisted DB, zod validation, idempotent finance, interview-gated chat. Legacy paths kept for old frontend builds."
  },
  "servers": [{ "url": "http://localhost:5000" }],
  "security": [{ "bearerAuth": [] }],
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } } },
