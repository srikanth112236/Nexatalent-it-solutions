    "/api/v1/interviews/{id}/feedback": { "post": { "summary": "Panel feedback (rating 1-5, never mutates status)", "responses": { "201": { "description": "created" } } }, "get": { "summary": "List feedback for interview", "responses": { "200": { "description": "ok" } } } },
