# WARNING: values below are LOCAL DEV ONLY. Never copy this file to production.
# Production boots ONLY with 32+ char JWT_SECRET + REFRESH_TOKEN_SECRET and a
# real PAYMENT_WEBHOOK_SECRET (see config/index.ts fail-closed check).
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200,http://localhost:5173
# NOTE: the app persists to backend/data/*.json — MONGODB_URI is unused.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_32PLUS_CHAR_RANDOM_STRING_DEV_ONLY
JWT_EXPIRES_IN=7d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_TOKEN_SECRET=REPLACE_WITH_32PLUS_CHAR_RANDOM_STRING_DEV_ONLY
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_16PLUS_CHAR_RANDOM_STRING_DEV_ONLY
# Local dev seed helpers (NEVER set in production):
# DEMO_SEED=off
# ALLOW_SEED_CREDENTIALS=true
# SEED_PASSWORD=REPLACE_WITH_12PLUS_CHAR_DEV_PASSWORD
# BOOTSTRAP_KEY=REPLACE_WITH_16PLUS_CHAR_RANDOM_STRING
