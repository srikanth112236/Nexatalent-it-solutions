# ==============================================================================
# NexaTalent Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Frontend Client URL & CORS (comma separated origins)
CLIENT_URL=https://brave-rock-07c996e0f.azurestaticapps.net
CORS_ORIGINS=https://brave-rock-07c996e0f.azurestaticapps.net,https://salmon-island-078be1a0f.azurestaticapps.net,https://nexatalent-frontend-app.azurewebsites.net,http://localhost:3000,http://localhost:4200

# JWT & Authentication Security (Must be 32+ characters in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_32_character_random_hex_string_jwt_secret
REFRESH_TOKEN_SECRET=replace_with_32_character_random_hex_string_refresh_token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Webhook & Bootstrap Security (Must be 16+ characters in production)
PAYMENT_WEBHOOK_SECRET=replace_with_16_character_random_hex_string_webhook
BOOTSTRAP_KEY=replace_with_16_character_random_hex_string_bootstrap

# Database (Default JSON file store uses backend/data/*.json)
MONGODB_URI=mongodb://localhost:27017/nexatalent

# ==============================================================================
# Azure Blob Storage (For Resumes, Candidate Docs & Attachments)
# ==============================================================================
# Option 1: Azure Storage Connection String (Recommended - copy from Azure Portal:
# Storage Account > Security + networking > Access keys > Connection string)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your_storage_account>;AccountKey=<your_account_key>;EndpointSuffix=core.windows.net

# Option 2: Account Name + Key (Used if connection string is not provided)
AZURE_STORAGE_ACCOUNT=nexatalentstore1234
AZURE_STORAGE_KEY=your_azure_storage_access_key==
AZURE_STORAGE_CONTAINER=resumes
AZURE_STORAGE_URL=https://nexatalentstore1234.blob.core.windows.net

# ==============================================================================
# Azure VM Deployment Details (Workload 4)
# ==============================================================================
VM_IP=20.xxx.xxx.xxx
DEPLOY_USER=azureuser
DEPLOY_KEY_PATH=~/.ssh/id_rsa

# ==============================================================================
# Email & SMTP (Optional)
# ==============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key
SMTP_FROM=noreply@nexatalent.com
